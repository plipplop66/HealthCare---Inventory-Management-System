{
  "name": "medripple",
  "version": "0.1.0",
  "private": true,
  "description": "MEDRIPPLE prototype workspace",
  "scripts": {
    "dev": "pnpm --filter @medripple/backend dev",
    "start": "pnpm --filter @medripple/backend start",
    "test": "pnpm --filter @medripple/backend test",
    "check": "pnpm --filter @medripple/backend check",
    "db:up": "docker compose -f database/compose.yaml up -d",
    "db:down": "docker compose -f database/compose.yaml down",
    "db:logs": "docker compose -f database/compose.yaml logs -f mysql",
    "stack:up": "docker compose up --build -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f"
  },
  "packageManager": "pnpm@11.19.0"
}
