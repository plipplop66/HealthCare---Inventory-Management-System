# Backend runtime
BACKEND_PORT=3001
BACKEND_HOST=127.0.0.1
NODE_ENV=development

# Data source. Keep `fixture` while the database is not running; switch to
# `mysql` after starting the Compose database or configuring a MySQL instance.
DATA_SOURCE=fixture

# MySQL connection. These values match database/compose.yaml.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=medripple
DATABASE_USER=medripple
DATABASE_PASSWORD=medripple_dev_only
# DATABASE_URL=mysql://medripple:medripple_dev_only@127.0.0.1:3306/medripple

# Keep the deterministic database seed on its simulation date. This prevents
# the 2026 fixture data from becoming stale when the calendar moves on.
SIMULATION_DATE=2026-09-11

# Comma-separated browser origins. Leave empty to allow local development origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: URL of Druv's FastAPI service. Without it, the API returns clearly
# labelled deterministic fixture forecasts so the frontend can keep moving.
INTELLIGENCE_SERVICE_URL=
INTELLIGENCE_TIMEOUT_MS=2500
